@page "/counter"
@inject IJSRuntime Jsr;

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<br />
<br />
<h1>Blazor Webcam</h1>
<video id="videoElement" autoplay></video>
<button class="btn btn-primary mb-3" @onclick="CaptureFrame">Capture Frame</button>
<br />
<br/>
<div>
    @if (!string.IsNullOrEmpty(base64Image))
    {
        <img src="@base64Image" alt="Captured image" />
    }
</div>
@code {

    private int currentCount = 0;
    private string base64Image;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Jsr.InvokeVoidAsync("cameraInterop.startCamera", "videoElement");
        }
    }

    private async Task CaptureFrame()
    {
        try
        {
            base64Image = await Jsr.InvokeAsync<string>("cameraInterop.captureImage");
            // The image data is now stored in base64Image and will be displayed by the img element
            StateHasChanged(); // Ensure the UI updates to display the new image
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error capturing image: {ex.Message}");
        }
    }

    private void IncrementCount()
    {
        currentCount++;
    }
}
